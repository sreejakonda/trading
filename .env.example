# ── Copy to .env and fill in. `.env` is git-ignored. ────────────────────────
# The CLI auto-loads .env; you do not need to `source` it.

# ── Mode ─────────────────────────────────────────────────────────────────────
# test  = simulated fills on live data (default — no account needed)
# paper = Alpaca paper trading (real market infrastructure, fake money)
# live  = Alpaca live trading (real money — requires LIVE_CONFIRM=yes below)
TRADING_MODE=test

# Required for TRADING_MODE=paper or live.
# Get keys at: https://app.alpaca.markets → API Keys
# ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxx
# ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Guards for live mode — live orders refused unless LIVE_CONFIRM=yes.
LIVE_CONFIRM=no

# ── Risk (all optional; sensible defaults in config.py) ──────────────────────
CAPITAL=2000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=25
MAX_POSITIONS=4
DAILY_LOSS_LIMIT_PCT=3.0
TIME_STOP_MINUTES=60

# Strategy + universe (optional).
STRATEGY=momentum
# WATCHLIST=AAPL,NVDA,TSLA,AMD,META,MSFT,AMZN,GOOGL,NFLX,PLTR,COIN,SOFI

# ── Claude advisor (optional) ────────────────────────────────────────────────
# If unset, the engine trades on the rules alone.
# ANTHROPIC_API_KEY=sk-ant-...
