# ── Copy to .env and fill in. `.env` is git-ignored. ────────────────────────
# The CLI auto-loads .env; you do not need to `source` it.

# ── Mode ─────────────────────────────────────────────────────────────────────
# test = simulated fills on live data (default, safe).
# live = REAL Robinhood orders.
TRADING_MODE=test

# Live-only safety gates. Live orders are refused unless LIVE_CONFIRM=yes.
# DRY_RUN=true simulates even in live mode (logs intended orders, sends none).
LIVE_CONFIRM=no
DRY_RUN=false

# ── Risk (all optional; sensible defaults in config.py) ──────────────────────
CAPITAL=2000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=25
MAX_POSITIONS=4
DAILY_LOSS_LIMIT_PCT=3.0
TIME_STOP_MINUTES=60

# Strategy + universe (optional).
STRATEGY=momentum
# WATCHLIST=AAPL,NVDA,TSLA,AMD,META,MSFT,AMZN,GOOGL,NFLX,PLTR,COIN,SOFI

# ── Claude advisor (optional) ────────────────────────────────────────────────
# If unset, the engine trades on the rules alone.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Robinhood (only for TRADING_MODE=live) ───────────────────────────────────
# ROBINHOOD_USERNAME=you@example.com
# ROBINHOOD_PASSWORD=...
# ROBINHOOD_TOTP=base32secret   # MFA secret, required for unattended/cron runs
